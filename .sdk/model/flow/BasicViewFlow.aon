# BasicViewFlow

main: kit: flow: BasicViewFlow:
{
  entity: "view",
  kind: "basic",
  name: "BasicViewFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "view_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicViewFlow"
}