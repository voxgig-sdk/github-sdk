# BasicProtectedBranchFlow

main: kit: flow: BasicProtectedBranchFlow:
{
  entity: "protected_branch",
  kind: "basic",
  name: "BasicProtectedBranchFlow",
  step: [
    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "protected_branch_ref01",
        srcdatavar: "protected_branch_ref01_data",
        suffix: "_up0",
        textfield: "url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-protected_branch_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProtectedBranchFlow"
}