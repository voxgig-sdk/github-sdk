# BasicCloneFlow

main: kit: flow: BasicCloneFlow:
{
  entity: "clone",
  kind: "basic",
  name: "BasicCloneFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "clone_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCloneFlow"
}