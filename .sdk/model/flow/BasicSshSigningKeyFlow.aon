# BasicSshSigningKeyFlow

main: kit: flow: BasicSshSigningKeyFlow:
{
  entity: "ssh_signing_key",
  kind: "basic",
  name: "BasicSshSigningKeyFlow",
  step: [
    {
      input: {
        ref: "ssh_signing_key_ref01"
      }

      match: {
        username: "username01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "ssh_signing_key_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "ssh_signing_key_ref01",
        srcdatavar: "ssh_signing_key_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "ssh_signing_key01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ssh_signing_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSshSigningKeyFlow"
}