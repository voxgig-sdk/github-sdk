# BasicLabelFlow

main: kit: flow: BasicLabelFlow:
{
  entity: "label",
  kind: "basic",
  name: "BasicLabelFlow",
  step: [
    {
      input: {
        ref: "label_ref01"
      }

      match: {
        milestone_number: "milestone_number01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "label_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "label_ref01",
        srcdatavar: "label_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-label_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "label_ref01",
        srcdatavar: "label_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "label01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-label_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLabelFlow"
}