# BasicMigrationFlow

main: kit: flow: BasicMigrationFlow:
{
  entity: "migration",
  kind: "basic",
  name: "BasicMigrationFlow",
  step: [
    {
      input: {
        ref: "migration_ref01"
      }

      match: {
        org_id: "org01",
        owner: "owner01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "migration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "migration_ref01",
        srcdatavar: "migration_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "migration01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-migration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "migration_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "migration01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "migration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMigrationFlow"
}