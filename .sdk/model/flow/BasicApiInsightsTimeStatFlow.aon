# BasicApiInsightsTimeStatFlow

main: kit: flow: BasicApiInsightsTimeStatFlow:
{
  entity: "api_insights_time_stat",
  kind: "basic",
  name: "BasicApiInsightsTimeStatFlow",
  step: [
    {
      match: {
        org_id: "org01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "api_insights_time_stat_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "api_insights_time_stat_ref01",
        srcdatavar: "api_insights_time_stat_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "api_insights_time_stat01",
        org_id: "org01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-api_insights_time_stat_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicApiInsightsTimeStatFlow"
}