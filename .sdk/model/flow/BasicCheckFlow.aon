# BasicCheckFlow

main: kit: flow: BasicCheckFlow:
{
  entity: "check",
  kind: "basic",
  name: "BasicCheckFlow",
  step: [
    {
      match: {
        owner: "owner01",
        ref: "ref01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "check_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCheckFlow"
}