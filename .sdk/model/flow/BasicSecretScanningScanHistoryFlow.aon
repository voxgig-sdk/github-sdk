# BasicSecretScanningScanHistoryFlow

main: kit: flow: BasicSecretScanningScanHistoryFlow:
{
  entity: "secret_scanning_scan_history",
  kind: "basic",
  name: "BasicSecretScanningScanHistoryFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_scanning_scan_history_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretScanningScanHistoryFlow"
}