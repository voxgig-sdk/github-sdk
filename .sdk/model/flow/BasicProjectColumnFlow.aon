# BasicProjectColumnFlow

main: kit: flow: BasicProjectColumnFlow:
{
  entity: "project_column",
  kind: "basic",
  name: "BasicProjectColumnFlow",
  step: [
    {
      input: {
        ref: "project_column_ref01"
      }

      match: {
        project_id: "project01"
      }

      op: "create"
    }

    {
      match: {
        project_id: "project01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_column_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_column_ref01",
        srcdatavar: "project_column_ref01_data",
        suffix: "_up0",
        textfield: "cards_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_column_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "project_column_ref01",
        srcdatavar: "project_column_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "project_column01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_column_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectColumnFlow"
}