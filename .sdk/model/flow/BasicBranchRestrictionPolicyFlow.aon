# BasicBranchRestrictionPolicyFlow

main: kit: flow: BasicBranchRestrictionPolicyFlow:
{
  entity: "branch_restriction_policy",
  kind: "basic",
  name: "BasicBranchRestrictionPolicyFlow",
  step: [
    {
      match: {
        branch_id: "branch01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "branch_restriction_policy_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchRestrictionPolicyFlow"
}