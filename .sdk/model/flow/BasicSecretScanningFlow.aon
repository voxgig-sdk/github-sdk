# BasicSecretScanningFlow

main: kit: flow: BasicSecretScanningFlow:
{
  entity: "secret_scanning",
  kind: "basic",
  name: "BasicSecretScanningFlow",
  step: [
    {
      input: {
        ref: "secret_scanning_ref01",
        srcdatavar: "secret_scanning_ref01_data",
        suffix: "_up0",
        textfield: "pattern_config_version"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_scanning_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretScanningFlow"
}