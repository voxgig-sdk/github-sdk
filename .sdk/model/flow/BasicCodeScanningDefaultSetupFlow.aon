# BasicCodeScanningDefaultSetupFlow

main: kit: flow: BasicCodeScanningDefaultSetupFlow:
{
  entity: "code_scanning_default_setup",
  kind: "basic",
  name: "BasicCodeScanningDefaultSetupFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_scanning_default_setup_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeScanningDefaultSetupFlow"
}