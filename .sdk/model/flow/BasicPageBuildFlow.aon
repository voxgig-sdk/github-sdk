# BasicPageBuildFlow

main: kit: flow: BasicPageBuildFlow:
{
  entity: "page_build",
  kind: "basic",
  name: "BasicPageBuildFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "page_build_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "page_build_ref01",
        srcdatavar: "page_build_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "page_build01",
        owner: "owner01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-page_build_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPageBuildFlow"
}