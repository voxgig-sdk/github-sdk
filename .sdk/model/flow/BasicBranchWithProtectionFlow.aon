  step: [
    {
      input: {
        ref: "branch_with_protection_ref01"
      }

      match: {
        branch: "branch01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }
  ],
  "key$": "BasicBranchWithProtectionFlow"
}