# BasicProjectsClassicFlow

main: kit: flow: BasicProjectsClassicFlow:
{
  entity: "projects_classic",
  kind: "basic",
  name: "BasicProjectsClassicFlow",
  step: [
    {
      input: {
        ref: "projects_classic_ref01"
      }

      match: {
        column_id: "column01",
        project_id: "project01"
      }

      op: "create"
    }

    {
      data: {
        project_id: "project01"
      }

      input: {
        ref: "projects_classic_ref01",
        srcdatavar: "projects_classic_ref01_data",
        suffix: "_up0",
        textfield: "permission"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-projects_classic_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "projects_classic_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "projects_classic01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicProjectsClassicFlow"
}