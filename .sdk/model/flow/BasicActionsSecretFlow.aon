# BasicActionsSecretFlow

main: kit: flow: BasicActionsSecretFlow:
{
  entity: "actions_secret",
  kind: "basic",
  name: "BasicActionsSecretFlow",
  step: [
    {
      input: {
        ref: "actions_secret_ref01",
        srcdatavar: "actions_secret_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "actions_secret01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-actions_secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicActionsSecretFlow"
}