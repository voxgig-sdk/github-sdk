# BasicGitTagFlow

main: kit: flow: BasicGitTagFlow:
{
  entity: "git_tag",
  kind: "basic",
  name: "BasicGitTagFlow",
  step: [
    {
      input: {
        ref: "git_tag_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      input: {
        ref: "git_tag_ref01",
        srcdatavar: "git_tag_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "git_tag01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-git_tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGitTagFlow"
}