# BasicCodeFrequencyFlow

main: kit: flow: BasicCodeFrequencyFlow:
{
  entity: "code_frequency",
  kind: "basic",
  name: "BasicCodeFrequencyFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_frequency_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeFrequencyFlow"
}