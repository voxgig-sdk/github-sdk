# BasicMilestoneFlow

main: kit: flow: BasicMilestoneFlow:
{
  entity: "milestone",
  kind: "basic",
  name: "BasicMilestoneFlow",
  step: [
    {
      input: {
        ref: "milestone_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "milestone_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "milestone_ref01",
        srcdatavar: "milestone_ref01_data",
        suffix: "_up0",
        textfield: "avatar_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-milestone_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "milestone_ref01",
        srcdatavar: "milestone_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "milestone01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-milestone_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMilestoneFlow"
}