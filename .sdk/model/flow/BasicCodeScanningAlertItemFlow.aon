# BasicCodeScanningAlertItemFlow

main: kit: flow: BasicCodeScanningAlertItemFlow:
{
  entity: "code_scanning_alert_item",
  kind: "basic",
  name: "BasicCodeScanningAlertItemFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_scanning_alert_item_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeScanningAlertItemFlow"
}