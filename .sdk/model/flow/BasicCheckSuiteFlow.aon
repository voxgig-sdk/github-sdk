# BasicCheckSuiteFlow

main: kit: flow: BasicCheckSuiteFlow:
{
  entity: "check_suite",
  kind: "basic",
  name: "BasicCheckSuiteFlow",
  step: [
    {
      input: {
        ref: "check_suite_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      input: {
        ref: "check_suite_ref01",
        srcdatavar: "check_suite_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "check_suite01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-check_suite_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCheckSuiteFlow"
}