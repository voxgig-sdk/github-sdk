# BasicBranchFlow

main: kit: flow: BasicBranchFlow:
{
  entity: "branch",
  kind: "basic",
  name: "BasicBranchFlow",
  step: [
    {
      input: {
        ref: "branch_ref01",
        srcdatavar: "branch_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "branch01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchFlow"
}