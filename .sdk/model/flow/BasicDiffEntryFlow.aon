# BasicDiffEntryFlow

main: kit: flow: BasicDiffEntryFlow:
{
  entity: "diff_entry",
  kind: "basic",
  name: "BasicDiffEntryFlow",
  step: [
    {
      match: {
        owner: "owner01",
        pull_number: "pull_number01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "diff_entry_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDiffEntryFlow"
}