# BasicIntegrationFlow

main: kit: flow: BasicIntegrationFlow:
{
  entity: "integration",
  kind: "basic",
  name: "BasicIntegrationFlow",
  step: [
    {
      input: {
        ref: "integration_ref01"
      }

      match: {
        branch_id: "branch01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "integration_ref01",
        srcdatavar: "integration_ref01_data",
        suffix: "_up0",
        textfield: "client_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-integration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "integration_ref01",
        srcdatavar: "integration_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "integration01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-integration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "integration_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "integration01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIntegrationFlow"
}