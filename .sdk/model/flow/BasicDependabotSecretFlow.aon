# BasicDependabotSecretFlow

main: kit: flow: BasicDependabotSecretFlow:
{
  entity: "dependabot_secret",
  kind: "basic",
  name: "BasicDependabotSecretFlow",
  step: [
    {
      input: {
        ref: "dependabot_secret_ref01",
        srcdatavar: "dependabot_secret_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "dependabot_secret01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dependabot_secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDependabotSecretFlow"
}