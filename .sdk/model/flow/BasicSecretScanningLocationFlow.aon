# BasicSecretScanningLocationFlow

main: kit: flow: BasicSecretScanningLocationFlow:
{
  entity: "secret_scanning_location",
  kind: "basic",
  name: "BasicSecretScanningLocationFlow",
  step: [
    {
      match: {
        alert_number: "alert_number01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_scanning_location_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretScanningLocationFlow"
}