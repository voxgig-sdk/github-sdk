# BasicCheckAnnotationFlow

main: kit: flow: BasicCheckAnnotationFlow:
{
  entity: "check_annotation",
  kind: "basic",
  name: "BasicCheckAnnotationFlow",
  step: [
    {
      match: {
        check_run_id: "check_run01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "check_annotation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCheckAnnotationFlow"
}