# BasicIssueTypeFlow

main: kit: flow: BasicIssueTypeFlow:
{
  entity: "issue_type",
  kind: "basic",
  name: "BasicIssueTypeFlow",
  step: [
    {
      input: {
        ref: "issue_type_ref01"
      }

      match: {
        org_id: "org01"
      }

      op: "create"
    }

    {
      match: {
        org_id: "org01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "issue_type_ref01"
          }
        }
      ]
    }

    {
      data: {
        org_id: "org01"
      }

      input: {
        ref: "issue_type_ref01",
        srcdatavar: "issue_type_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issue_type_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIssueTypeFlow"
}