# BasicRuleSuiteFlow

main: kit: flow: BasicRuleSuiteFlow:
{
  entity: "rule_suite",
  kind: "basic",
  name: "BasicRuleSuiteFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "rule_suite_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "rule_suite_ref01",
        srcdatavar: "rule_suite_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "rule_suite01",
        org_id: "org01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rule_suite_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRuleSuiteFlow"
}