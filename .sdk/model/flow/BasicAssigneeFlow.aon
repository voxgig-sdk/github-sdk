# BasicAssigneeFlow

main: kit: flow: BasicAssigneeFlow:
{
  entity: "assignee",
  kind: "basic",
  name: "BasicAssigneeFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "assignee_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAssigneeFlow"
}