# BasicHookFlow

main: kit: flow: BasicHookFlow:
{
  entity: "hook",
  kind: "basic",
  name: "BasicHookFlow",
  step: [
    {
      input: {
        ref: "hook_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "hook_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "hook_ref01",
        srcdatavar: "hook_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hook_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "hook_ref01",
        srcdatavar: "hook_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "hook01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hook_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHookFlow"
}