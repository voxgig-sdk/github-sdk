# BasicReactionFlow

main: kit: flow: BasicReactionFlow:
{
  entity: "reaction",
  kind: "basic",
  name: "BasicReactionFlow",
  step: [
    {
      input: {
        ref: "reaction_ref01"
      }

      match: {
        comment_id: "comment01",
        comment_number: "comment_number01",
        discussion_id: "discussion01",
        discussion_number: "discussion_number01",
        issue_id: "issue01",
        issue_number: "issue_number01",
        org_id: "org01",
        owner: "owner01",
        release_id: "release01",
        repo: "repo01",
        team_id: "team01"
      }

      op: "create"
    }

    {
      match: {
        discussion_number: "discussion_number01",
        team_id: "team01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "reaction_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "reaction_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "reaction01",
        owner: "owner01",
        release_id: "release01",
        repo: "repo01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        discussion_number: "discussion_number01",
        team_id: "team01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "reaction_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReactionFlow"
}