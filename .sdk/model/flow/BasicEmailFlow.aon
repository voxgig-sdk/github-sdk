# BasicEmailFlow

main: kit: flow: BasicEmailFlow:
{
  entity: "email",
  kind: "basic",
  name: "BasicEmailFlow",
  step: [
    {
      input: {
        ref: "email_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "email_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "email_ref01",
        srcdatavar: "email_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailFlow"
}