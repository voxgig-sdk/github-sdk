  entity: "organization_secret_scanning_alert",
  kind: "basic",
  name: "BasicOrganizationSecretScanningAlertFlow",
  step: [
    {
      match: {
        enterprise: "enterprise01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "organization_secret_scanning_alert_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrganizationSecretScanningAlertFlow"
}