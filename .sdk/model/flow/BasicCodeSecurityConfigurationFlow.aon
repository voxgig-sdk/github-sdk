# BasicCodeSecurityConfigurationFlow

main: kit: flow: BasicCodeSecurityConfigurationFlow:
{
  entity: "code_security_configuration",
  kind: "basic",
  name: "BasicCodeSecurityConfigurationFlow",
  step: [
    {
      input: {
        ref: "code_security_configuration_ref01"
      }

      match: {
        enterprise: "enterprise01",
        org_id: "org01",
        owner: "owner01"
      }

      op: "create"
    }

    {
      match: {
        enterprise: "enterprise01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_security_configuration_ref01"
          }
        }
      ]
    }

    {
      data: {
        org_id: "org01"
      }

      input: {
        ref: "code_security_configuration_ref01",
        srcdatavar: "code_security_configuration_ref01_data",
        suffix: "_up0",
        textfield: "advanced_security"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-code_security_configuration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "code_security_configuration_ref01",
        srcdatavar: "code_security_configuration_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "code_security_configuration01",
        owner: "owner01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-code_security_configuration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeSecurityConfigurationFlow"
}