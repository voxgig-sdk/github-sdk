# BasicCodeownersErrorFlow

main: kit: flow: BasicCodeownersErrorFlow:
{
  entity: "codeowners_error",
  kind: "basic",
  name: "BasicCodeownersErrorFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "codeowners_error_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeownersErrorFlow"
}