# BasicCommitActivityFlow

main: kit: flow: BasicCommitActivityFlow:
{
  entity: "commit_activity",
  kind: "basic",
  name: "BasicCommitActivityFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "commit_activity_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCommitActivityFlow"
}