# BasicCopilotFlow

main: kit: flow: BasicCopilotFlow:
{
  entity: "copilot",
  kind: "basic",
  name: "BasicCopilotFlow",
  step: [
    {
      input: {
        ref: "copilot_ref01"
      }

      match: {
        org_id: "org01"
      }

      op: "create"
    }

    {
      match: {
        org_id: "org01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "copilot_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "copilot_ref01",
        srcdatavar: "copilot_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "copilot01",
        org_id: "org01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-copilot_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "copilot_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "copilot01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        org_id: "org01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "copilot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCopilotFlow"
}