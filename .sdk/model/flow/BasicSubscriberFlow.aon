# BasicSubscriberFlow

main: kit: flow: BasicSubscriberFlow:
{
  entity: "subscriber",
  kind: "basic",
  name: "BasicSubscriberFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "subscriber_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSubscriberFlow"
}