# BasicCodeScanningAlertInstanceFlow

main: kit: flow: BasicCodeScanningAlertInstanceFlow:
{
  entity: "code_scanning_alert_instance",
  kind: "basic",
  name: "BasicCodeScanningAlertInstanceFlow",
  step: [
    {
      match: {
        alert_number: "alert_number01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_scanning_alert_instance_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeScanningAlertInstanceFlow"
}