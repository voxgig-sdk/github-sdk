# BasicReferrerFlow

main: kit: flow: BasicReferrerFlow:
{
  entity: "referrer",
  kind: "basic",
  name: "BasicReferrerFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "referrer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReferrerFlow"
}