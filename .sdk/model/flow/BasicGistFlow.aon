# BasicGistFlow

main: kit: flow: BasicGistFlow:
{
  entity: "gist",
  kind: "basic",
  name: "BasicGistFlow",
  step: [
    {
      input: {
        ref: "gist_ref01"
      }

      match: {
        gist_id: "gist01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "gist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "gist_ref01",
        srcdatavar: "gist_ref01_data",
        suffix: "_up0",
        textfield: "comments_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-gist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "gist_ref01",
        srcdatavar: "gist_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "gist01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-gist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "gist_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "gist01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "gist_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGistFlow"
}