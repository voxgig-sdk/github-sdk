# BasicPorterAuthorFlow

main: kit: flow: BasicPorterAuthorFlow:
{
  entity: "porter_author",
  kind: "basic",
  name: "BasicPorterAuthorFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "porter_author_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "porter_author_ref01",
        srcdatavar: "porter_author_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-porter_author_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPorterAuthorFlow"
}