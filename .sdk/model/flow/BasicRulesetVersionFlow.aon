# BasicRulesetVersionFlow

main: kit: flow: BasicRulesetVersionFlow:
{
  entity: "ruleset_version",
  kind: "basic",
  name: "BasicRulesetVersionFlow",
  step: [
    {
      match: {
        org_id: "org01",
        ruleset_id: "ruleset01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "ruleset_version_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRulesetVersionFlow"
}