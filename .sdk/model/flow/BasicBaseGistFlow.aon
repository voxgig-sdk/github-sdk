# BasicBaseGistFlow

main: kit: flow: BasicBaseGistFlow:
{
  entity: "base_gist",
  kind: "basic",
  name: "BasicBaseGistFlow",
  step: [
    {
      input: {
        ref: "base_gist_ref01"
      }

      match: {
        gist_id: "gist01",
        username: "username01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "base_gist_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBaseGistFlow"
}