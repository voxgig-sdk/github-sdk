# BasicSecretScanningAlertFlow

main: kit: flow: BasicSecretScanningAlertFlow:
{
  entity: "secret_scanning_alert",
  kind: "basic",
  name: "BasicSecretScanningAlertFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_scanning_alert_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "secret_scanning_alert_ref01",
        srcdatavar: "secret_scanning_alert_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_scanning_alert_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "secret_scanning_alert_ref01",
        srcdatavar: "secret_scanning_alert_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "secret_scanning_alert01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_scanning_alert_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretScanningAlertFlow"
}