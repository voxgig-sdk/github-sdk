# BasicTagProtectionFlow

main: kit: flow: BasicTagProtectionFlow:
{
  entity: "tag_protection",
  kind: "basic",
  name: "BasicTagProtectionFlow",
  step: [
    {
      input: {
        ref: "tag_protection_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "tag_protection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTagProtectionFlow"
}