# BasicReleaseFlow

main: kit: flow: BasicReleaseFlow:
{
  entity: "release",
  kind: "basic",
  name: "BasicReleaseFlow",
  step: [
    {
      input: {
        ref: "release_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "release_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01",
        repo: "repo01"
      }

      input: {
        ref: "release_ref01",
        srcdatavar: "release_ref01_data",
        suffix: "_up0",
        textfield: "assets_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-release_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "release_ref01",
        srcdatavar: "release_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "release01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-release_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReleaseFlow"
}