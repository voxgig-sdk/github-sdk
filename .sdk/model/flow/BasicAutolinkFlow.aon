# BasicAutolinkFlow

main: kit: flow: BasicAutolinkFlow:
{
  entity: "autolink",
  kind: "basic",
  name: "BasicAutolinkFlow",
  step: [
    {
      input: {
        ref: "autolink_ref01"
      }

      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "create"
    }

    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "autolink_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "autolink_ref01",
        srcdatavar: "autolink_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "autolink01",
        owner: "owner01",
        repo: "repo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-autolink_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAutolinkFlow"
}