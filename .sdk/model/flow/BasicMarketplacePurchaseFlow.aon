    {
      input: {
        ref: "marketplace_purchase_ref01",
        srcdatavar: "marketplace_purchase_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "marketplace_purchase01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-marketplace_purchase_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMarketplacePurchaseFlow"
}