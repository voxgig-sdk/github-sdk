# BasicTopicFlow

main: kit: flow: BasicTopicFlow:
{
  entity: "topic",
  kind: "basic",
  name: "BasicTopicFlow",
  step: [
    {
      match: {
        owner: "owner01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "topic_ref01"
          }
        }
      ]
    }

    {
      data: {
        owner: "owner01"
      }

      input: {
        ref: "topic_ref01",
        srcdatavar: "topic_ref01_data",
        suffix: "_up0"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-topic_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTopicFlow"
}