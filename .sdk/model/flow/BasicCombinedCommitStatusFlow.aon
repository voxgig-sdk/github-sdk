# BasicCombinedCommitStatusFlow

main: kit: flow: BasicCombinedCommitStatusFlow:
{
  entity: "combined_commit_status",
  kind: "basic",
  name: "BasicCombinedCommitStatusFlow",
  step: [
    {
      match: {
        owner: "owner01",
        ref: "ref01",
        repo: "repo01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "combined_commit_status_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCombinedCommitStatusFlow"
}