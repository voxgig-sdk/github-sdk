# BasicCodeOfConductFlow

main: kit: flow: BasicCodeOfConductFlow:
{
  entity: "code_of_conduct",
  kind: "basic",
  name: "BasicCodeOfConductFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "code_of_conduct_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "code_of_conduct_ref01",
        srcdatavar: "code_of_conduct_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "code_of_conduct01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-code_of_conduct_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCodeOfConductFlow"
}