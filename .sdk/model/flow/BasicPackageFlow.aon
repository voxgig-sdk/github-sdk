# BasicPackageFlow

main: kit: flow: BasicPackageFlow:
{
  entity: "package",
  kind: "basic",
  name: "BasicPackageFlow",
  step: [
    {
      input: {
        ref: "package_ref01"
      }

      match: {
        org: "org01",
        org_id: "org01",
        package_id: "package01",
        package_name: "package_name01",
        package_type: "package_type01",
        username: "username01",
        version_id: "version01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "package_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "package_ref01",
        srcdatavar: "package_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "package01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-package_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "package_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "package01",
        package_type: "package_type01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "package_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPackageFlow"
}