# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 5

  entity: repo: {
    path: "/repos/{owner}/{repo}": {
      op: load: method: *GET
      op: patch: method: *PATCH
      op: remove: method: *DELETE
    }
    path: "/user/repos": {
      op: create: method: *POST
      op: list: method: *GET
    }
  }

}