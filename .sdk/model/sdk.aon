
# Model definitions.
@"@voxgig/apidef/model/apidef.aon"
@"@voxgig/sdkgen/model/sdkgen.aon"


# SDK Details.
name: 'github'
origin: 'voxgig-sdk'
def: 'github-repo-only.json'


# API Information
@"api/api-info.aon"


# SDK Configuration.
@"config.aon"


# SDK Entities
@"entity/entity-index.aon"


# SDK Features.
@"feature/feature-index.aon"
 

# SDK Targets.
@"target/target-index.aon"


# Operation workflows.
@"flow/flow-index.aon"


# Seneca provider plugin generates out-of-tree into the sibling repo.
# `adopt` writes into that checkout when it is there; `create: false` skips
# the target when it is not, so a fresh clone never fabricates a sibling.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/github-provider'
  sdkrel: '../../voxgig-sdk/github-sdk'
  adopt: true
  create: false
}

