# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it, unlike every other file it writes.
#
# Everything else under model/ is toolchain-derived and is deliberately
# regenerated so that toolchain fixes propagate. Put anything here that is a
# decision about THIS project rather than a fact about the API.
#
# Included LAST by sdk.aon, after target/target-index.aon, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.


# WHERE THE SENECA PROVIDER IS GENERATED.
#
# This lives here rather than in sdk.aon because create-sdkgen rewrites
# sdk.aon from its template on every scaffold, and this path is a fact about
# one developer's checkout layout, not about the API. `target add` overwrites
# model/target/seneca-provider.aon, so it cannot live there either.
#
# THE DIRECTORY NAME IS THE REPOSITORY NAME. The repo is
# senecajs/seneca-github-provider, so a default `git clone` produces
# `seneca-github-provider`. The previous value here said
# `../../seneca/github-provider`, which matches no clone anyone would make,
# and because `create: false` skips a target whose output folder is absent,
# the result was a GREEN generate run that emitted no provider at all — one
# INFO line, `generate-external-skip`, and exit 0. Getting this wrong is
# silent, so it is worth checking that the provider tree actually changed
# after a run that was supposed to change it.
#
# `adopt` writes into that checkout when it is there; `create: false` keeps a
# fresh clone from fabricating a sibling directory.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/seneca-github-provider'
  sdkrel: '../../voxgig-sdk/github-sdk'
  adopt: true
  create: false
}


# THE PROVIDER'S RELEASE VERSION.
#
# npm already carries @seneca/github-provider at 0.0.2 and 0.2.0. The
# generated manifest declared the schema default of 0.0.1, which is BELOW
# what is published: no existing install could resolve this work as an
# upgrade, and releasing it would have meant tagging v0.0.1 for a package
# that has shipped twice already.
#
# 0.3.0, not 0.2.1: under 0.x a minor bump is how a breaking change is
# spelt, and this release is breaking twice over — the entity set narrowed
# from 15 to 2 (senecajs/seneca-github-provider#31) and the credential key
# was renamed (#32, now accepted as an alias, so that half no longer
# breaks). The narrowing still wants a release note; a version number cannot
# say it on its own.
main: kit: target: 'seneca-provider': publish: version: '0.3.3'


# HOW THE PROVIDER DEPENDS ON THIS SDK.
#
# Nothing here any more, deliberately: @voxgig-sdk/github-sdk is PUBLISHED,
# so the default — the published package pinned to the version this model
# builds — is the right dependency and needs no override.
#
# What was here, until the package existed: a `sdk: dep` block pointing the
# provider at a GitHub release asset, because an unpublished SDK left the
# provider unable to install, build, test or release at all. It also carried
# a cost that could not be fixed from this side — npm 12 refuses a remote
# tarball by default (`allow-remote` is "none"), and the `--allow-remote=all`
# the generated CI passed does NOT travel to anyone installing the published
# provider. Publishing was always the real answer; this is it arriving.


# THE PUBLISHED PACKAGE NAME.
#
# Derived, the name is `@voxgig-sdk/github`: packageName appends `-sdk` to
# the slug UNLESS the origin already ends in it, and this origin is
# `voxgig-sdk`. The registry name wanted here carries the suffix anyway, so
# it is declared outright — which is what this key exists for, a project
# whose registry name is not what the slug derives and which cannot rename
# the slug without renaming every SDK class along with it.
main: kit: target: ts: publish: registry: package: '@voxgig-sdk/github-sdk'


# THE SDK'S RELEASE VERSION.
#
# 0.0.2 because the PACKAGE NAME changed: v0.0.1 is published as a release
# asset named for the old name, and a reader asking which tag carries
# `@voxgig-sdk/github-sdk` should get one answer. Reusing 0.0.1 would leave
# two different packages claiming the same version.
main: kit: target: ts: publish: version: '0.0.3'
