# Local config / secrets
*.local.*
*.local

# Dependencies (no trailing slash: also ignores node_modules SYMLINKS, e.g.
# .sdk/node_modules -> shared tree, which a dir-only rule leaves tracked)
node_modules

# Build output
dist/
dist-test/
*.tsbuildinfo

# Generated logs
log/
*.log

# apidef writes each `.aon` model file's derived `.aontu` twin (and this
# project's own compat symlinks, see build/link-aon-compat.js) back into the
# working tree; neither needs to be committed, both regenerate on build.
model/sdk.aontu
model/config.aontu
model/entity/*.aontu
model/flow/*.aontu
model/guide/*.aontu
model/feature/*.aontu
model/api/*.aontu
model/target/*.aontu
apidef-warnings.txt

# OS
.DS_Store
