{
  "name": "build-github-sdk",
  "version": "0.0.1",
  "description": "Github SDK Project",
  "scripts": {
    "generate": "tsc --build src && voxgig-model model/sdk.aon && voxgig-model test/test.aon",
    "watch-generate": "voxgig-model -w model/sdk.aon",
    "dry-generate": "tsc --build src && voxgig-model -y model/sdk.aon",
    "watch-dry-generate": "voxgig-model -w -y model/sdk.aon",
    "test-model": "voxgig-model test/test.aon",
    "watch-test-model": "voxgig-model -w test/test.aon",
    "watch": "tsc --build src -w",
    "build": "tsc --build src",
    "test": "echo no-test",
    "clean": "rm -rf dist dist-test node_modules yarn.lock package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "add-target": "voxgig-sdkgen target add",
    "dry-add-target": "voxgig-sdkgen -y target add",
    "add-feature": "voxgig-sdkgen feature add",
    "dry-add-feature": "voxgig-sdkgen -y feature add"
  },
  "author": "Github",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.2.0",
    "@voxgig/apidef": "8.3.0",
    "@voxgig/model": "11.0.1",
    "@voxgig/sdkgen": "4.11.0",
    "@voxgig/sdkgen-infrapack": "0.0.3",
    "@voxgig/struct": "0.3.5",
    "@voxgig/util": "0.5.4",
    "aontu": "0.61.0",
    "jostraca": "0.33.1",
    "typescript": "7.0.2"
  }
}
